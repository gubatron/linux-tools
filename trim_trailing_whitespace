#!/usr/bin/env bash

# Function to remove all trailing whitespace (spaces and tabs) from files
trim_trailing_whitespace() {
    local recursive=0
    local files=()
    local item process_file sed_i_arg

    # Determine the correct sed -i syntax (Linux vs. macOS/BSD)
    # The empty string '' is only required on BSD/macOS sed
    if [[ "$(uname)" == "Darwin" ]]; then
        # macOS/BSD sed requires the backup extension argument
        sed_i_arg='-i ""'
    else
        # Linux (GNU) sed does not require or accept a separate argument for no backup
        sed_i_arg='-i'
    fi

    # --- 1. Argument Parsing (Same as before) ---
    while [[ "$#" -gt 0 ]]; do
        case "$1" in
            -r|--recursive)
                recursive=1
                shift
                ;;
            -h|--help)
                echo "Usage: trim_trailing_whitespace [OPTIONS] <file_or_directory1> [file_or_directory2]..."
                echo ""
                echo "Options:"
                echo "  -r, --recursive   Process files in directories recursively."
                echo "  -h, --help        Show this help message."
                return 0
                ;;
            -*)
                echo "Error: Unknown option '$1'" >&2
                return 1
                ;;
            *)
                files+=("$@")
                break
                ;;
        esac
    done

    # --- 2. Check for Files/Directories ---
    if [ ${#files[@]} -eq 0 ]; then
        echo "Error: No files or directories provided." >&2
        trim_trailing_whitespace --help
        return 1
    fi

    # --- 3. Core Trailing Whitespace Removal Logic ---
    process_file() {
        local file="$1"

        # Use eval to correctly execute the sed command with the determined -i argument
        # We wrap the substitution command in a single string for proper evaluation
        eval "sed ${sed_i_arg} 's/[[:space:]]*$//' \"\$file\""

        echo "  [CLEANED] $file"
    }

    # --- 4. Process the Arguments ---
    for item in "${files[@]}"; do
        if [ -f "$item" ]; then
            process_file "$item"
        elif [ -d "$item" ]; then
            if [ "$recursive" -eq 1 ]; then
                echo "Processing directory recursively: $item"
                # Use find and shell expansion to correctly apply the determined sed command
                find "$item" -type f -exec bash -c "sed ${sed_i_arg} 's/[[:space:]]*$//' \"\$0\"" {} \;
                echo "  [CLEANED] All files in $item (recursively)"
            else
                echo "Error: '$item' is a directory. Use the -r or --recursive flag to process contents." >&2
                return 1
            fi
        else
            echo "Error: Path not found: $item" >&2
        fi
    done
}

# CRITICAL: Execute the function with the script's arguments
trim_trailing_whitespace "$@"
